#!/bin/sh
if [ -z "${ZSH_VERSION:-}" ] && [ -z "${BASH_VERSION:-}" ]; then
  if command -v zsh >/dev/null 2>&1; then
    exec zsh "$0" "$@"
  elif command -v bash >/dev/null 2>&1; then
    exec bash "$0" "$@"
  fi
fi

if [ -z "$1" ]
  then
    git commit -am 'feat: ' -e
  else
    if [ -z "$2" ]
      then
        git commit -am "feat: $1"
      else
        git commit -am "feat($1): $2"
    fi
fi
